{
  "uid": "gpudeck-gpu-fleet",
  "title": "GPU Deck / GPU fleet",
  "description": "Accelerators and GPU machines (metrics.md §1, §5).",
  "tags": [
    "gpu-deck",
    "gpu"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "GPU Deck dashboards",
      "type": "dashboards",
      "tags": [
        "gpu-deck"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpudeck_gpu_utilization_ratio, node)",
          "refId": "var-node"
        },
        "definition": "label_values(gpudeck_gpu_utilization_ratio, node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "vendor",
        "label": "Vendor",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpudeck_gpu_utilization_ratio, vendor)",
          "refId": "var-vendor"
        },
        "definition": "label_values(gpudeck_gpu_utilization_ratio, vendor)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(gpudeck_gpu_utilization_ratio, device_name)",
          "refId": "var-device"
        },
        "definition": "label_values(gpudeck_gpu_utilization_ratio, device_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
