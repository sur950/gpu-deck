          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(gpudeck_usage_gpu_seconds_total{api_key=~\"$api_key\", model=~\"$model\"}[$__range])) / 3600",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cost",
