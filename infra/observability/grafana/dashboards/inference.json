          "query": "label_values(gpudeck_engine_active_sessions, model)",
          "refId": "var-model"
        },
        "definition": "label_values(gpudeck_engine_active_sessions, model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
