        "query": {
          "query": "label_values(up{job=~\"gpudeck-.*\"}, job)",
          "refId": "var-job"
        },
        "definition": "label_values(up{job=~\"gpudeck-.*\"}, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
