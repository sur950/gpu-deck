# ==========================================
# GPU Deck — Web App Environment Variables
# Copy this file to .env.local for local development.
# Every value is NEXT_PUBLIC_* and is baked in at build time.
# The Docker image needs none of the backend values: its gateway serves the UI and
# /api on one origin (GPUDECK_API_INTERNAL_URL at runtime, see server/gateway.mjs).
# ==========================================

# ── Backend ──────────────────────────────────────────────────────────────────
# Admin API base URL (include the /api/v1 suffix). Leave it unset to use the UI's own
# origin (/api/v1, what the Docker image does); `pnpm dev` talks to the admin API on 8180.
NEXT_PUBLIC_API_URL=http://localhost:8180/api/v1

# Name of the HttpOnly session cookie set by the backend (presence-only check
# in proxy.ts; the backend validates it)
NEXT_PUBLIC_SESSION_COOKIE=gpudeck_session

# Name of the readable CSRF cookie (double-submit). Its value is sent back as
# the X-CSRF-Token header on every POST/PUT/PATCH/DELETE.
NEXT_PUBLIC_CSRF_COOKIE=gpudeck_csrf

# ── Branding (white label; docs/BRAND.md) ────────────────────────────────────
NEXT_PUBLIC_APP_NAME="GPU Deck"
# Descriptor line under the name in the logo lockup and in the page title.
NEXT_PUBLIC_APP_BYLINE="GPU control plane"
# Brand accent (primary buttons, links, active nav, focus, chart series 1). The
# default is the GPU Deck crimson (#D3263F in dark mode); a custom colour is
# used as-is in both modes.
NEXT_PUBLIC_BRAND_COLOR="#B3122E"
# Optional custom logo (absolute URL or /public path). Empty = GPU Deck lockup.
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_FAVICON_URL=/favicon.ico
# dark | light — the mode a browser opens in before the user toggles it
NEXT_PUBLIC_DEFAULT_COLOR_MODE=dark

# ── Polling ──────────────────────────────────────────────────────────────────
# Live mode polling interval for log pages (milliseconds)
NEXT_PUBLIC_LOG_POLL_INTERVAL_MS=15000
