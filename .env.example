# ==========================================
# GPU Deck backend — environment template (repo root)
# GENERATED by scripts/check_env_docs.py --write from app/core/settings/*.py —
# do not edit by hand (CI fails on drift). Reference: libs/contracts/env.md.
# Copy to apps/fastapi/.env (gitignored). Values with CHANGE-ME must be replaced.
# Commented lines (# NAME=) are optional and unset by default.
# Local dev: infra/scripts/bootstrap.dev.sh writes the DB/Redis sections from
# the Docker dev dependencies (infra/docker/docker-compose.deps.yml; ports
# 55432 / 56379 on 127.0.0.1, credentials generated into infra/docker/.env).
# ==========================================


# ---------- Application, listeners, URLs (app/core/settings/app.py) ----------
# Application name
APP_NAME="GPU Deck"
# Application version
APP_VERSION=1.0.0
# Environment: development, staging, production
APP_ENV=development
# Debug mode (enables /docs and error details)
DEBUG=true
# Admin API v1 prefix
API_V1_PREFIX=/api/v1
# Timezone for schedules and workers
TZ=UTC
# Bind host for every HTTP listener
#   (also accepted: ADMIN_HOST)
HOST=0.0.0.0
# Admin API port (app.main)
#   (also accepted: ADMIN_PORT)
PORT=8180
# Serving API port (app.api_layer_main)
API_LAYER_PORT=8181
# Agent hub WSS port (mTLS); node agents dial out to it
AGENT_HUB_PORT=8443
# Node-agent engine proxy port (mTLS) the API layer calls
AGENT_PROXY_PORT=9443
# Gunicorn workers per API process in production
WORKERS=4
# Auto-reload on code changes (dev only)
RELOAD=true
# OpenAI-format root (mounted at <root>/v1)
SERVING_OPENAI_PREFIX=/openai
# Anthropic-format root (mounted at <root>/v1)
SERVING_ANTHROPIC_PREFIX=/anthropic
# Ollama-format root (mounted at <root>/api)
SERVING_OLLAMA_PREFIX=/ollama
# Run the APScheduler loop inside the admin API process instead of the dedicated jobs process (python -m app.workers.scheduler). Single-container only.
SCHEDULER_EMBEDDED=false
# Web UI base URL (CORS, links)
FRONTEND_URL=http://localhost:3180
# Public base URL of the admin API
#   (also accepted: ADMIN_PUBLIC_URL)
PUBLIC_API_URL=http://localhost:8180
# Public base URL of the serving API
#   (also accepted: API_LAYER_PUBLIC_URL)
PUBLIC_SERVING_URL=http://localhost:8181
# Comma-separated allowed browser origins (scheme + host, no trailing slash)
CORS_ORIGINS=http://localhost:3180
# Allow credentials
CORS_CREDENTIALS=true
# Extra Host header values accepted in production (comma list; hostnames from CORS_ORIGINS / PUBLIC_API_URL / PUBLIC_SERVING_URL are always accepted)
TRUSTED_HOSTS=localhost,127.0.0.1
# Allowed methods (* or comma list)
CORS_METHODS=*
# Allowed headers (* or comma list)
CORS_HEADERS=*

# ---------- Platform (Celery, scheduler, HTTP) (app/core/settings/platform.py) ----------
# Git SHA of the running build (CI sets it)
# BUILD_SHA=
# Agent protocol major (libs/contracts/agent-protocol envelope.v)
AGENT_PROTOCOL_VERSION=1

# ---------- Logging, Prometheus, OpenTelemetry (app/core/settings/observability.py) ----------
# Log level
LOG_LEVEL=INFO
# Log format: json or text
LOG_FORMAT=text
# Loguru file sink path
LOG_FILE_PATH=logs/app.log
# Log rotation size
LOG_ROTATION="500 MB"
# Log retention period
LOG_RETENTION="10 days"
# Serving API: fraction of requests that get an INFO access-log line (the rest log at DEBUG; 5xx always log at WARNING)
SERVING_ACCESS_LOG_SAMPLE_RATE=0.01
# Expose Prometheus /metrics
METRICS_ENABLED=true
# Prometheus port of the Celery worker process (celery_tasks_total; 0 = off). Prefork pools need PROMETHEUS_MULTIPROC_DIR
WORKER_METRICS_PORT=9464
# Prometheus port of the jobs/scheduler process (rules, swaps, leader; 0 = off)
SCHEDULER_METRICS_PORT=9465
# Bind address of the worker/scheduler Prometheus listeners
METRICS_BIND_HOST=0.0.0.0
# OTLP gRPC endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTel service name base
OTEL_SERVICE_NAME=gpu-deck
# OTel traces sampler
OTEL_TRACES_SAMPLER=always_on
# Print spans to stdout when no OTLP endpoint is set
OTEL_CONSOLE_EXPORT=false
# Enable health checks
HEALTH_CHECK_ENABLED=true
# Health check interval
HEALTH_CHECK_INTERVAL_SECONDS=30

# ---------- Branding (white label) (app/core/settings/branding.py) ----------
# Product name shown in the UI (defaults to APP_NAME)
# BRAND_NAME=
# Descriptor line under the logo (env.md: APP_BYLINE)
#   (also accepted: APP_BYLINE)
BRAND_TAGLINE="GPU control plane"
# Company name for footers (optional)
# BRAND_COMPANY=
# Logo URL, absolute or app-relative (env.md: LOGO_URL)
#   (also accepted: LOGO_URL)
BRAND_LOGO_URL=/branding/logo.svg
# Logo URL for the dark theme (empty = same as BRAND_LOGO_URL)
# BRAND_LOGO_DARK_URL=
# Favicon URL (env.md: FAVICON_URL)
#   (also accepted: FAVICON_URL)
BRAND_FAVICON_URL=/branding/favicon.svg
# Primary accent color (env.md: BRAND_COLOR). The default is the GPU Deck crimson; the web app uses its dark step #D3263F in dark mode
#   (also accepted: BRAND_COLOR)
BRAND_PRIMARY_COLOR="#B3122E"
# Support link (optional)
#   (also accepted: SUPPORT_URL)
# BRAND_SUPPORT_URL=
# Docs link (optional)
#   (also accepted: DOCS_URL)
# BRAND_DOCS_URL=

# ---------- Security, sessions, admin seed, API keys, IP rules, TLS (app/core/settings/security.py) ----------
# Signs session tokens, derives the session Fernet key, keys the CSRF and admin-seed HMACs (>= 32 chars)
SECRET_KEY=CHANGE-ME-min-32-chars-random-hex
# Comma-separated Fernet keys for the secrets vault, newest first
VAULT_KEYS=CHANGE-ME-fernet-key
# Redis TTL of cached vault ciphertext
CACHE_TTL_CREDENTIALS_SECONDS=86400
# Seeded admin login name
ADMIN_USERNAME=admin
# Seeded admin password
ADMIN_PASSWORD=CHANGE-ME-strong-password
# Seeded admin display name (env.md: ADMIN_DISPLAY_NAME)
#   (also accepted: ADMIN_DISPLAY_NAME)
ADMIN_NAME=Administrator
# Session cookie (admin.yaml: gpudeck_session)
SESSION_COOKIE_NAME=gpudeck_session
# Session TTL in hours (hard expiry)
SESSION_EXPIRE_HOURS=12
# Sliding idle expiry in minutes (0 = off)
SESSION_IDLE_TIMEOUT_MINUTES=60
# Shared parent domain for the cookie; unset for local dev
# SESSION_COOKIE_DOMAIN=
# Force the Secure cookie flag (default: only in production)
# SESSION_COOKIE_SECURE=
# Readable CSRF cookie
CSRF_COOKIE_NAME=gpudeck_csrf
# CSRF header name
CSRF_HEADER_NAME=X-CSRF-Token
# Enforce CSRF on state-changing requests
CSRF_ENABLED=true
# Failed logins before lockout
#   (also accepted: LOGIN_LOCKOUT_ATTEMPTS)
AUTH_LOCKOUT_ATTEMPTS=5
# Lockout duration in minutes
#   (also accepted: LOGIN_LOCKOUT_MINUTES)
AUTH_LOCKOUT_MINUTES=15
# Minimum length for a UI-set password
AUTH_PASSWORD_MIN_LENGTH=12
# Flag must_change_password while the seed password is in use
AUTH_REQUIRE_PASSWORD_CHANGE=false
# argon2-cffi time cost
ARGON2_TIME_COST=3
# argon2-cffi memory cost (KiB)
ARGON2_MEMORY_KIB=65536
# argon2-cffi parallelism
ARGON2_PARALLELISM=2
# Prefix of generated API keys (serving.md §3: gd- + 48 hex). Keys issued under an older prefix keep working: lookup is by SHA-256 of the full key
API_KEY_PREFIX=gd-
# Redis TTL of verified API keys on the serving API
API_KEY_CACHE_TTL_SECONDS=60
# Process-local cache of verified API keys (bounded by the invalidation pub/sub); keeps the hot path memory-only
API_KEY_LOCAL_CACHE_SECONDS=1.0
# Enable slowapi rate limiting
RATE_LIMIT_ENABLED=true
# Default requests per minute
RATE_LIMIT_PER_MINUTE=120
# Login attempts per minute
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Admin API implicit allow rules
# IP_ALLOWLIST=
# Admin API implicit block rules
# IP_BLOCKLIST=
# Serving API implicit allow rules (your AI gateway's IPs)
#   (also accepted: SERVING_IP_ALLOWLIST)
# GATEWAY_IP_ALLOWLIST=
# Comma-separated IPs/CIDRs of reverse proxies (Caddy, load balancer) whose X-Forwarded-For / X-Real-IP headers are believed when evaluating IP rules. Headers from any other peer are ignored so clients cannot spoof their address.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Redis TTL of the per-scope ip_rules snapshot
IP_RULES_CACHE_TTL_SECONDS=30
# Process-local snapshot age before re-reading Redis
IP_RULES_LOCAL_CACHE_SECONDS=2.0
# Server certificate (PEM) for admin/serving listeners that terminate TLS
#   (also accepted: ADMIN_TLS_CERT_PATH)
# TLS_CERT_FILE=
# Server private key (PEM)
#   (also accepted: ADMIN_TLS_KEY_PATH)
# TLS_KEY_FILE=
# CA bundle used to verify peers
# TLS_CA_FILE=
# Agent hub server cert (empty = issued by the internal CA)
#   (also accepted: AGENT_HUB_TLS_CERT_PATH)
# AGENT_HUB_TLS_CERT_FILE=
# Agent hub server key
#   (also accepted: AGENT_HUB_TLS_KEY_PATH)
# AGENT_HUB_TLS_KEY_FILE=
# Internal CA that signs node-agent client certificates (mTLS)
# AGENT_HUB_CLIENT_CA_FILE=
# Directory holding the internal CA material (dev)
PKI_CA_DIR=certs

# ---------- PostgreSQL (app/core/settings/database.py) ----------
# PostgreSQL host
POSTGRES_HOST=127.0.0.1
# PostgreSQL port
POSTGRES_PORT=55432
# PostgreSQL user
POSTGRES_USER=gpu_deck
# PostgreSQL password
POSTGRES_PASSWORD=CHANGE-ME
# PostgreSQL database
POSTGRES_DB=gpu_deck_dev
# PostgreSQL schema
POSTGRES_SCHEMA=public
# Full database URL (postgresql:// or postgresql+asyncpg://)
DATABASE_URL=postgresql://gpu_deck:CHANGE-ME@127.0.0.1:55432/gpu_deck_dev
# disable | allow | prefer | require | verify-ca | verify-full (empty = driver default, prefer); verify-full in production
# POSTGRES_SSLMODE=
# CA bundle for verify-ca / verify-full (exported as PGSSLROOTCERT)
# POSTGRES_SSLROOTCERT=
# Connections kept open per API process
DB_POOL_SIZE=5
# Extra connections per process under load
DB_MAX_OVERFLOW=10
# Seconds a request waits for a free pooled connection
DB_POOL_TIMEOUT=60
# Enable pool pre-ping
DB_POOL_PRE_PING=true
# Connection recycle time in seconds
DB_POOL_RECYCLE=3600
# Log every SQL statement (very verbose; debugging only)
DB_ECHO=false
# Postgres idle_in_transaction_session_timeout in ms (0 disables)
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# Postgres statement_timeout in ms (0 disables)
DB_STATEMENT_TIMEOUT_MS=60000
# Postgres idle_session_timeout in ms, applied on PG 14+ (0 leaves it unset)
DB_IDLE_SESSION_TIMEOUT_MS=300000

# ---------- Redis, cache, Celery broker (app/core/settings/redis.py) ----------
# Redis host
REDIS_HOST=127.0.0.1
# Redis port
REDIS_PORT=56379
# Redis database index
REDIS_DB=0
# Redis ACL username (the dev Redis container uses 'gpu-deck'; a password alone authenticates as 'default').
REDIS_USERNAME=gpu-deck
# Redis password
REDIS_PASSWORD=CHANGE-ME
# Full Redis URL (wins when set)
REDIS_URL=redis://gpu-deck:CHANGE-ME@127.0.0.1:56379/0
# Prefix for every key and channel this app creates in Redis (the dev Redis ACL only allows keys under gpu-deck:)
REDIS_KEY_PREFIX=gpu-deck:
# Celery broker URL
# CELERY_BROKER_URL=
# Celery result backend URL
# CELERY_RESULT_BACKEND=
# Track task start
CELERY_TASK_TRACK_STARTED=true
# Hard task time limit (s)
CELERY_TASK_TIME_LIMIT=300
# Maximum task retries
CELERY_MAX_RETRIES=3
# Result TTL (s)
CELERY_TASK_RESULT_EXPIRES=86400
# Emit worker/task events (needed only for Flower)
CELERY_SEND_EVENTS=false

# ---------- Agent hub, PKI, fleet (app/core/settings/fleet.py) ----------
# Bind host of the agent hub
AGENT_HUB_HOST=0.0.0.0
# URL agents dial (embedded in join commands and hello_ack)
AGENT_HUB_PUBLIC_URL=https://localhost:8443
# Extra DNS names / IPs for the self-issued hub server certificate
AGENT_HUB_TLS_SANS=localhost,127.0.0.1
# Maximum WebSocket frame accepted from an agent
HUB_MAX_FRAME_BYTES=4194304
# Validate every inbound frame against libs/contracts/agent-protocol JSON Schemas (close 4002 on violation)
HUB_VALIDATE_SCHEMAS=true
# WebSocket ping cadence
HUB_PING_INTERVAL_SECONDS=15
# Import an existing CA certificate on first boot (read once)
# PKI_CA_CERT_PATH=
# Import the matching CA private key on first boot (read once)
# PKI_CA_KEY_PATH=
# Key type of a generated CA: ecdsa_p384 | ecdsa_p256
PKI_CA_KEY_TYPE=ecdsa_p384
# Generated CA validity
PKI_CA_VALIDITY_DAYS=3650
# Node agent cert validity
NODE_CERT_VALIDITY_DAYS=365
# Auto rotate_cert this many days before not_after
NODE_CERT_ROTATE_BEFORE_DAYS=30
# Revoke the previous cert this long after the new one connects
NODE_CERT_OLD_REVOKE_AFTER_SECONDS=600
# api_layer / control_plane / agent_hub cert validity
SERVICE_CERT_VALIDITY_DAYS=365
# Client cert for control-plane -> node proxy probes (empty = vault)
# CONTROL_PLANE_CLIENT_CERT_PATH=
# Client key for control-plane -> node proxy probes (empty = vault)
# CONTROL_PLANE_CLIENT_KEY_PATH=
# host:port list (comma separated) agents dial for the outbound serving tunnel, one per API-layer worker; empty = the AGENT_HUB_PUBLIC_URL host on AGENT_TUNNEL_PORT .. + AGENT_TUNNEL_LISTENERS - 1
# AGENT_TUNNEL_PUBLIC_URLS=
# Tunnel connections each agent keeps per endpoint
AGENT_TUNNEL_CONNECTIONS=2
# An agent redials a tunnel that received no request or keep-alive probe for this long
AGENT_TUNNEL_IDLE_TIMEOUT_SECONDS=60
# Direct mode: source CIDRs (the API layer's egress addresses) the node proxy accepts; empty = private ranges only. Per cluster: clusters.config.node_security.proxy_allowed_source_cidrs
# NODE_PROXY_ALLOWED_SOURCE_CIDRS=
# Source CIDRs of SSH instances started without their own; empty = such instances accept nobody. Per cluster: clusters.config.node_security.ssh_default_allowed_cidrs
# SSH_INSTANCE_DEFAULT_ALLOWED_CIDRS=
# Agents sum rejected inbound attempts per interval into one ingress_rejected event
NODE_INGRESS_REPORT_SECONDS=60
# Rejected inbound attempts per interval that make the event critical (raises a node.ingress_rejected alert)
NODE_INGRESS_ALERT_THRESHOLD=20
# Extra hub key pins (SubjectPublicKeyInfo sha256 hex, comma separated) to pre-publish before replacing AGENT_HUB_TLS_CERT_FILE with a new key
# AGENT_HUB_EXTRA_SPKI_PINS=
# Extra API-layer key pins to pre-publish before replacing API_LAYER_CLIENT_CERT_PATH with a new key
# API_LAYER_EXTRA_SPKI_PINS=
# After a hub / API-layer key rotation the previous key stays pinned this long (replicas restart onto the new key)
SERVICE_KEY_ROTATION_GRACE_HOURS=24
# Default join token TTL
JOIN_TOKEN_TTL_MINUTES=15
# Rate limit on /agent/v1/join
JOIN_RATE_LIMIT=10/minute
# No heartbeat -> offline
NODE_OFFLINE_AFTER_SECONDS=30
# Agent heartbeat cadence
HEARTBEAT_INTERVAL_SECONDS=10
# Agent scrape cadence
METRICS_INTERVAL_SECONDS=2.0
# Agent inventory cadence
INVENTORY_INTERVAL_SECONDS=60
# Ack deadline per command
COMMAND_ACK_TIMEOUT_SECONDS=10
# Default command timeout when the caller gives none
COMMAND_DEFAULT_TIMEOUT_SECONDS=900
# Comma list command=semver of the minimum agent version per command (e.g. run_benchmark=1.1.0); unsupported commands are rejected before sending
# COMMAND_MIN_AGENT_VERSIONS=
# Base egress allowlist pushed to every node (plus the hub and cluster extras)
EGRESS_ALLOWLIST_DEFAULT=huggingface.co:443,cdn-lfs.huggingface.co:443,cdn-lfs-us-1.huggingface.co:443,cas-bridge.xethub.hf.co:443,modelscope.cn:443,www.modelscope.cn:443

# ---------- Rules (app/core/settings/rules.py) ----------
# Evaluator tick: how often enabled rules are considered
RULES_TICK_SECONDS=10
# Default IANA zone for time_schedule rules and time windows
RULES_DEFAULT_TIMEZONE=UTC
# Cluster-wide cap on swap operations in a non-terminal state; rules that would exceed it record skipped(reason=swap_capacity)
RULES_MAX_CONCURRENT_SWAPS=2
# A no_match rule_runs row is written at most this often per rule
RULE_RUN_NO_MATCH_LOG_INTERVAL_SECONDS=3600
# rule_runs rows older than this are deleted by the retention job
RULE_RUNS_RETENTION_DAYS=30
# How far back a time_schedule rule looks for a missed run on start-up (catch_up); longer gaps are ignored
RULES_SCHEDULE_LOOKBACK_HOURS=48

# ---------- Swaps (app/core/settings/swap.py) ----------
# Drain timeout used when a swap request does not set one
SWAP_DEFAULT_DRAIN_TIMEOUT_SECONDS=120
# A swap older than this (since started_at) fails and rolls back
SWAP_MAX_DURATION_SECONDS=1800
# Default force_after_timeout for rule-triggered swaps: unload even if sessions remain after the drain timeout (false = fail and roll back)
SWAP_FORCE_AFTER_DRAIN_TIMEOUT=false
# How often the swap manager polls agent_commands for a result
SWAP_COMMAND_POLL_SECONDS=1.0
# TTL of the per-device Redis lock held while a swap runs
SWAP_DEVICE_LOCK_TTL_SECONDS=2400
# How often the jobs leader looks for pending/resumable swaps
SWAP_DRIVE_INTERVAL_SECONDS=5
# Timeout of the control-plane /_health probe through the proxy
SWAP_HEALTH_PROBE_TIMEOUT_SECONDS=5.0

# ---------- High availability (app/core/settings/ha.py) ----------
# Lease validity; a holder that stops renewing loses it after this
HA_LEASE_TTL_SECONDS=30
# How often the holder renews (must be well under the TTL)
HA_LEASE_RENEW_SECONDS=10
# Lease holder id of this process (default hostname:pid)
# HA_INSTANCE_ID=   (default computed at startup)

# ---------- Metrics, logs, traces, retention (app/core/settings/metrics.py) ----------
# metric_samples_* partitions kept (hours)
METRICS_RAW_RETENTION_HOURS=48
# metric_rollups_*_1m partitions kept (days)
METRICS_ROLLUP_RETENTION_DAYS=90
# log_chunks partitions kept
LOGS_RETENTION_DAYS=14
# traces partitions kept
TRACES_RETENTION_DAYS=7
# create_daily_partitions() horizon (today + N days)
PARTITIONS_DAYS_AHEAD=7
# Max buckets per series in /metrics/* (from/to/step guard)
METRICS_QUERY_MAX_POINTS=5000
# Latest sample older than this reads as null in `live` fields
METRICS_LIVE_STALE_SECONDS=10
# How far back the minute rollup job backfills on a gap
METRICS_ROLLUP_CATCHUP_MINUTES=120
# Rows per insert batch in the hub ingest
DB_METRICS_INGEST_BATCH_SIZE=2000
# Bearer token required on /api/v1/metrics/prometheus when set
# PROMETHEUS_SCRAPE_TOKEN=
# Lines per log event / chunk
LOG_CHUNK_MAX_LINES=100
# Agent log flush interval
LOG_FLUSH_INTERVAL_MS=1000
# Agents forward engine stdout/stderr as log events
LOG_FORWARD_ENGINE_OUTPUT=true
# Max rows per /logs page
LOGS_QUERY_MAX_LIMIT=1000
# Replay window honoured for Last-Event-ID on /live/events
LIVE_EVENTS_REPLAY_SECONDS=60
# SSE heartbeat cadence
LIVE_HEARTBEAT_SECONDS=15
# Ratio for parentbased_traceidratio samplers
OTEL_TRACES_SAMPLER_ARG=0.1
# Deep link template to an external tracing UI, with {trace_id}
# OTEL_UI_URL=
# Grafana link shown in the UI
# GRAFANA_URL=
# Write a span index into the traces table (v2 request traces; off in v1)
TRACE_INDEX_ENABLED=false

# ---------- Audit log (app/core/settings/audit.py) ----------
# Delete audit rows older than this (0 = keep forever)
AUDIT_RETENTION_DAYS=365
# Upper bound of rows in one CSV export
AUDIT_EXPORT_MAX_ROWS=50000
# Celery queue for audit writes
AUDIT_QUEUE=audit

# ---------- Serving API layer (app/core/settings/serving.py) ----------
# Also serve /v1/* and /api/* without a format prefix
SERVING_ENABLE_BARE_PATHS=true
# List models with a deployment but no ready instance
SERVING_LIST_UNLOADED_MODELS=false
# Ask the control plane to start a stopped deployment when a request arrives for it and wait SERVING_NO_INSTANCE_WAIT_SECONDS
SERVING_ON_DEMAND_LOAD=false
# Wait for a loading instance before 503 model_not_ready
SERVING_NO_INSTANCE_WAIT_SECONDS=30
# Skip an instance after a connect/TLS failure for this long
SERVING_EJECT_SECONDS=10
# Rewrite the response model field back to the requested name
SERVING_REWRITE_RESPONSE_MODEL=true
# Add x-gpudeck-model/deployment/instance/node headers
SERVING_EXPOSE_ROUTING_HEADERS=true
# Cap for JSON request bodies (413 beyond)
SERVING_MAX_JSON_BODY_BYTES=16777216
# Cap for multipart uploads (413 beyond)
SERVING_MAX_UPLOAD_BYTES=268435456
# Max embeddings input items / rerank documents
SERVING_MAX_INPUT_ITEMS=2048
# Total time limit per request (non-video)
SERVING_REQUEST_TIMEOUT_SECONDS=600
# Max gap between upstream stream frames
SERVING_STREAM_IDLE_TIMEOUT_SECONDS=120
# TCP/TLS connect timeout to the node-agent proxy
SERVING_CONNECT_TIMEOUT_SECONDS=5.0
# Timeout for async video generation jobs
SERVING_VIDEO_JOB_TIMEOUT_SECONDS=3600
# In-flight cap per API-layer process (503 instance_busy)
SERVING_MAX_CONCURRENT_REQUESTS=1024
# Max requests per batch
SERVING_BATCH_MAX_ITEMS=10000
# Max batch request body size
SERVING_BATCH_MAX_BYTES=268435456
# Batch lifetime
SERVING_BATCH_EXPIRES_HOURS=24
# Days batch results stay retrievable
SERVING_BATCH_RESULTS_RETENTION_DAYS=29
# Parallel items per batch in the jobs process
SERVING_BATCH_CONCURRENCY=4
# anthropic-version echoed when the client sends none
SERVING_ANTHROPIC_DEFAULT_VERSION=2023-06-01
# Model used for API-layer compaction instead of the request's model
# SERVING_COMPACTION_MODEL_OVERRIDE=
# max_tokens of the summarisation call the API layer runs
SERVING_COMPACTION_MAX_TOKENS=2048
# Fallback poll of the Redis routing table when pub/sub is silent
ROUTING_TABLE_POLL_SECONDS=5
# How often per-instance in-flight counts are flushed to Redis
SERVING_INFLIGHT_FLUSH_MS=250
# /health answers 503 unless the routing table lists >= 1 online node (serving.md); off by default so an empty dev stack is healthy
SERVING_HEALTH_REQUIRE_NODES=false
# Run the outbound-tunnel listener agents dial in serving mode tunnel (protocol.md §13)
AGENT_TUNNEL_ENABLED=true
# Bind address of the agent tunnel listener
AGENT_TUNNEL_BIND=0.0.0.0
# Agent tunnel listener port (TLS 1.3, node client certificate required)
AGENT_TUNNEL_PORT=8444
# Tunnel ports per API-layer host (AGENT_TUNNEL_PORT upward): one per worker process (set it to the gunicorn WORKERS count); the hub lists every port
AGENT_TUNNEL_LISTENERS=1
# Keep-alive probe interval per tunnel connection (also detects dead ones)
AGENT_TUNNEL_KEEPALIVE_SECONDS=10.0
# Concurrent unauthenticated tunnel handshakes accepted
AGENT_TUNNEL_MAX_PENDING_HANDSHAKES=256
# Client certificate (PEM) presented to node-agent proxies
# API_LAYER_CLIENT_CERT_PATH=
# Private key (PEM) of the client certificate
# API_LAYER_CLIENT_KEY_PATH=
# CA bundle override (otherwise the routing table's ca_bundle_pem)
# API_LAYER_CA_BUNDLE_PATH=
# Verify node-agent proxy certificates (dev only: false)
SERVING_UPSTREAM_VERIFY_TLS=true
# Idle time a pooled connection to a node-agent proxy is kept for reuse (a new one costs TCP + TLS round trips)
SERVING_UPSTREAM_KEEPALIVE_SECONDS=300.0
# Offer HTTP/2 (ALPN h2) to node-agent proxies; one connection multiplexes concurrent requests. HTTP/1.1 is used when a proxy does not negotiate h2
SERVING_UPSTREAM_HTTP2=true
# Connection cap of the pool towards one node-agent proxy
SERVING_UPSTREAM_MAX_CONNECTIONS_PER_NODE=512
# Idle connections kept per node-agent proxy
SERVING_UPSTREAM_MAX_KEEPALIVE_PER_NODE=128
# Open connections to a node proxy as soon as it serves an instance and keep idle pools warm
SERVING_UPSTREAM_PREWARM=true
# Connections opened per node proxy when it is first routed
SERVING_UPSTREAM_WARM_CONNECTIONS=2
# Interval of the GET /_health ping that keeps each routed node's pool warm (0 = off; keep it below the agent's 30 s HTTP/2 keep-alive ping)
SERVING_UPSTREAM_KEEPWARM_SECONDS=20
# Direct engine base URL for local testing (e.g. http://127.0.0.1:11434); requests go to {url}/{engine_path} without a node-agent proxy
# SERVING_DEV_ENGINE_URL=
# Comma-separated serving names the dev engine answers to ('*' = any)
SERVING_DEV_ENGINE_MODELS=*
# Formats the dev engine speaks natively (openai,ollama)
SERVING_DEV_ENGINE_FORMATS=openai
# Model family hint for the dev engine (thinking tag handling)
# SERVING_DEV_ENGINE_FAMILY=
# Model type of the dev engine model(s)
SERVING_DEV_ENGINE_TYPE=chat

# ---------- Request limits (app/core/settings/limits.py) ----------
# Maximum request body (bytes) on the serving API
MAX_REQUEST_BODY_BYTES=33554432
# Maximum multipart body (bytes) for audio/image upload endpoints
MAX_UPLOAD_BODY_BYTES=268435456
# Upper bound for one non-streaming serving request
REQUEST_TIMEOUT_SECONDS=600
# Abort a stream when the engine sends nothing for this long
STREAM_IDLE_TIMEOUT_SECONDS=120
# TCP/TLS connect timeout to the node-agent proxy
ENGINE_CONNECT_TIMEOUT_SECONDS=5.0
# Maximum request body (bytes) on the admin API
ADMIN_MAX_REQUEST_BODY_BYTES=4194304

# ---------- Metering (app/core/settings/metering.py) ----------
# Re-run the current hour's rollup this often
METERING_ROLLUP_INTERVAL_MINUTES=5
# Drop usage_events partitions older than this
USAGE_EVENTS_RETENTION_DAYS=400

# ---------- Alerts (app/core/settings/alerts.py) ----------
# min_severity for new channels when not given
ALERT_DEFAULT_MIN_SEVERITY=warning
# Events with the same dedupe_key inside this window bump occurrences instead of creating a new alert_events row
ALERT_DEDUPE_WINDOW_SECONDS=600
# alert_events older than this are deleted by the retention job
ALERT_EVENTS_RETENTION_DAYS=90
# HTTP / SMTP timeout for one delivery attempt
ALERT_SEND_TIMEOUT_SECONDS=10.0
# Delivery attempts per (event, channel)
ALERT_MAX_ATTEMPTS=3
# Base backoff between delivery attempts (doubles per attempt)
ALERT_RETRY_BACKOFF_SECONDS=30
# Default SMTP host for email channels
# SMTP_HOST=
# Default SMTP port
SMTP_PORT=587
# Default SMTP username
# SMTP_USERNAME=
# Vault credential name holding the SMTP password when a channel has none
SMTP_PASSWORD_CREDENTIAL=smtp-password
# Default From address
SMTP_FROM=gpudeck@localhost
# STARTTLS (or implicit TLS on port 465)
SMTP_USE_TLS=true
# Vault credential name used when a Slack channel has no credential_id
# SLACK_DEFAULT_WEBHOOK_CREDENTIAL=
# Vault credential name whose value signs webhook payloads (HMAC-SHA256 X-GPUDeck-Signature) when a channel has no credential_id
# WEBHOOK_SIGNING_SECRET_CREDENTIAL=

# ---------- Billing (app/core/settings/billing.py) ----------
# Display currency (prices are USD)
BILLING_CURRENCY=USD
# Day of month to auto-generate last month's report (0 = off)
BILLING_MONTHLY_REPORT_DAY=1

# ---------- Model catalog (app/core/settings/catalog.py) ----------
# Hugging Face hub base URL (mirror for offline sites)
HF_ENDPOINT=https://huggingface.co
# ModelScope base URL (mirror for offline sites)
MODELSCOPE_ENDPOINT=https://www.modelscope.cn
# Vault credential name holding an optional Hugging Face token
HF_TOKEN_CREDENTIAL=huggingface-token
# Vault credential name holding an optional ModelScope token
MODELSCOPE_TOKEN_CREDENTIAL=modelscope-token
# Redis TTL for remote catalog search / file-listing results
CATALOG_SEARCH_CACHE_SECONDS=300
# HTTP timeout for HF / ModelScope API calls
CATALOG_HTTP_TIMEOUT_SECONDS=20.0
# Comma-separated default scan roots offered in the UI
LOCAL_MODEL_SCAN_ROOTS=~/.ollama/models,~/.lmstudio/models,~/.cache/huggingface/hub,/models
# Safety cap on files visited by one local scan
LOCAL_SCAN_MAX_FILES=20000

# ---------- Deployments, scheduler, model cache (app/core/settings/deployments.py) ----------
# Default localhost port range for engines on a node
ENGINE_PORT_RANGE=10240-10340
# Free VRAM kept per device when placing (percent of total)
SCHEDULER_VRAM_HEADROOM_PCT=10
# KV-cache bytes per token when the model config lacks shape
SCHEDULER_KV_BYTES_PER_TOKEN_FALLBACK=131072
# Max device combinations evaluated per node per replica
SCHEDULER_MAX_DEVICE_COMBOS=64
# Jobs-process tick that turns desired replicas into instances
DEPLOYMENT_RECONCILE_INTERVAL_SECONDS=15
# pending/loading instances older than this are marked error
DEPLOYMENT_LOAD_TIMEOUT_SECONDS=900
# Default drain timeout for unloads issued by deployments
DEPLOYMENT_UNLOAD_DRAIN_TIMEOUT_SECONDS=120
# Errored instances still count toward replicas this long (auto-heal window)
DEPLOYMENT_ERROR_GRACE_SECONDS=60
# Instance failures inside the window that mark a deployment failed
DEPLOYMENT_CRASHLOOP_ERRORS=3
# Crash-loop detection window
DEPLOYMENT_CRASHLOOP_WINDOW_SECONDS=600
# Stopped instance rows older than this are pruned
DEPLOYMENT_STOPPED_INSTANCE_RETENTION_DAYS=7
# Routing table refresh (live session counts) for the API layer
#   (also accepted: ROUTING_TABLE_REFRESH_SECONDS)
ROUTING_PUBLISH_INTERVAL_SECONDS=2
# How often the LRU cache sweep runs per node
MODEL_CACHE_LRU_SWEEP_INTERVAL_MINUTES=60
# Sweep a node cache when used bytes exceed this % of its limit
MODEL_CACHE_HIGH_WATER_PCT=90
# Sweep until used bytes drop under this % of the limit
MODEL_CACHE_LOW_WATER_PCT=75

# ---------- Benchmarks (app/core/settings/benchmark.py) ----------
# Base URL of the serving API the runner calls; empty = PUBLIC_SERVING_URL
# BENCHMARK_TARGET_URL=
# Vault credential name holding the API key the runner sends
BENCHMARK_API_KEY_CREDENTIAL=benchmark-api-key
# Plain API key for the runner (dev only; the vault credential wins)
# BENCHMARK_API_KEY=
# Per-request timeout during a load test
BENCHMARK_REQUEST_TIMEOUT_SECONDS=300.0
# Upper bound for any concurrency level
BENCHMARK_MAX_CONCURRENCY=512
# Verify the serving API certificate (off for self-signed dev certs)
BENCHMARK_VERIFY_TLS=true
# Running benchmark runs without progress this long are marked failed
BENCHMARK_STALE_RUN_MINUTES=180
# Auto-tune waits this long for a restarted instance to be ready
BENCHMARK_READY_WAIT_SECONDS=900

# ---------- Cloud GPU VMs (app/core/settings/cloud.py) ----------
# Comma list of cloud providers offered in the UI/API
CLOUD_PROVIDERS_ENABLED=aws,azure,gcp,digitalocean
# Node agent version cloud-init downloads from the hub (/agent/v1/downloads/{version}/{target}; latest = newest build in dist/agent)
CLOUD_AGENT_VERSION=latest
# Base URL of the agent download endpoint VMs use; empty = AGENT_HUB_PUBLIC_URL
# CLOUD_AGENT_DOWNLOAD_BASE_URL=
# TTL of the one-time join token baked into a VM's cloud-init
CLOUD_JOIN_TOKEN_TTL_MINUTES=60
# A VM whose agent has not joined after this long goes to status error
CLOUD_BOOT_TIMEOUT_MINUTES=30
# Node drain time limit before stop/terminate proceeds anyway
CLOUD_DRAIN_TIMEOUT_SECONDS=600
# Default cap of nodes per cloud cluster (clusters.config.cloud.max_nodes wins)
CLOUD_MAX_NODES_PER_CLUSTER=20
# Default VM disk size
CLOUD_DEFAULT_DISK_GB=200
# Cadence of the cloud.reconcile lifecycle job
CLOUD_RECONCILE_SECONDS=30
# How often a running/stopped VM is re-read from the provider
CLOUD_STATUS_POLL_SECONDS=300
# Redis cache of region / instance-type / price listings (0 = off)
CLOUD_CATALOG_CACHE_SECONDS=3600
# Per-call timeout for provider APIs
CLOUD_PROVIDER_TIMEOUT_SECONDS=60
# DigitalOcean REST API base URL
CLOUD_DO_API_URL=https://api.digitalocean.com
# Azure Retail Prices API (public, unauthenticated)
CLOUD_AZURE_PRICES_URL=https://prices.azure.com/api/retail/prices

# ---------- Agent_updates (app/core/settings/agent_updates.py) ----------
# Comma list of release signing public keys (base64 of the 32-byte ed25519 key) agent release manifests must be signed with. Sent to every node in its signed security policy. Empty = agent updates are off (nodes are updated by re-running the installer)
# AGENT_RELEASE_PUBLIC_KEYS=
# Agent version nodes are moved to (empty = the newest signed release available: AGENT_DIST_DIR / AGENT_CACHE_DIR, else this control plane's own version from AGENT_RELEASE_URL)
# AGENT_UPDATE_TARGET_VERSION=
# Download the target version to every node that can update itself in the background, ahead of any update (the update itself downloads nothing)
AGENT_UPDATE_PRESTAGE=true
# Nodes downloading a staged update at the same time
AGENT_UPDATE_STAGE_CONCURRENCY=4
# The updated agent must reconnect and report healthy within this, or the node rolls back to the previous binary
AGENT_UPDATE_HEALTH_TIMEOUT_SECONDS=120
# How often the scheduler advances updates, rollouts and maintenance windows
AGENT_UPDATE_TICK_SECONDS=10
# Lifetime of the per-node download token sent with stage_update
AGENT_UPDATE_TOKEN_TTL_SECONDS=3600

# ---------- Gpu_instances (app/core/settings/gpu_instances.py) ----------
# Local agent builds, checked first (offline / air-gapped override): <version>/<target>/ folders or flat release files gpudeck-agent-<version>-<target>.tar.gz + SHA256SUMS (empty = apps/node-agent/dist/agent in the repo)
# AGENT_DIST_DIR=
# Release download base: builds not found locally are fetched from <url>/v<version>/gpudeck-agent-<version>-<target>.tar.gz, verified against the release SHA256SUMS.txt and cached in AGENT_CACHE_DIR (empty = never fetch)
AGENT_RELEASE_URL=https://github.com/sur950/gpu-deck/releases/download
# Writable directory for agent builds fetched from AGENT_RELEASE_URL (empty = <tmp>/gpu-deck-agent-cache)
# AGENT_CACHE_DIR=
# URL prefix GPU machines fetch install.sh and downloads/ from (empty = AGENT_HUB_PUBLIC_URL + /agent/v1, the hub; a value ending in /api/v1 means the admin API's copies)
# AGENT_DOWNLOAD_BASE_URL=
# Image used when a request names none (must run sshd, protocol.md §8). Default: Ubuntu + OpenSSH (apps/node-agent/packaging/ssh-image), glibc so the NVIDIA runtime's nvidia-smi / libcuda run inside (Alpine images cannot)
GPU_INSTANCE_DEFAULT_IMAGE=ghcr.io/sur950/gpu-deck-ssh:1
# sshd port inside the default image (gpu-deck-ssh and linuxserver: 2222)
GPU_INSTANCE_DEFAULT_CONTAINER_PORT=2222
# Comma list of allowed image prefixes (empty = any image)
# GPU_INSTANCE_ALLOWED_IMAGES=
# TTL applied when a request gives none (0 = no TTL)
GPU_INSTANCE_DEFAULT_TTL_SECONDS=28800
# Upper bound for ttl_seconds / extensions
GPU_INSTANCE_MAX_TTL_SECONDS=604800
# Running SSH GPU instances allowed per node
GPU_INSTANCE_MAX_PER_NODE=16
# start_ssh_instance command timeout (image pull + boot)
GPU_INSTANCE_START_TIMEOUT_SECONDS=900
# stop_ssh_instance command timeout
GPU_INSTANCE_STOP_TIMEOUT_SECONDS=120
# Lifecycle tick (placement retries, TTL, idle, metering)
GPU_INSTANCE_TICK_SECONDS=15
# Write a GPU-minute usage event at least this often
GPU_INSTANCE_METER_INTERVAL_MINUTES=60
# Running instance missing from the agent inventory this long -> error
GPU_INSTANCE_NOT_REPORTED_GRACE_SECONDS=120

# ---------- Latency (app/core/settings/latency.py) ----------
# Stable id of this API layer in RTT reports and request logs (empty = the host name)
# API_LAYER_ID=
# Region label of this API layer (e.g. eu-west); RTT, traffic counts and placement are grouped by it
API_LAYER_REGION=default
# How often the API layer measures its round trip to every connected node (one GET /_health on the warm connection; 0 = off)
SERVING_RTT_PROBE_SECONDS=10.0
# Weight of the newest RTT sample in the smoothed value (0-1)
SERVING_RTT_EWMA_ALPHA=0.3
# Prefer the replica with the lowest expected latency (measured RTT plus a load penalty) for the least_sessions strategy
SERVING_LATENCY_ROUTING=true
# Replicas whose expected latency is within this many ms of the best share the traffic
SERVING_LATENCY_TOLERANCE_MS=5.0
# Expected extra latency (ms) of a replica running at its full concurrency; scaled by its in-flight share and weight
SERVING_LATENCY_LOAD_PENALTY_MS=200.0
# Concurrency assumed per replica for the load penalty when the deployment sets no max_concurrent
SERVING_LATENCY_DEFAULT_CAPACITY=8
# Server-Timing header on serving responses: off | generic (phase durations only) | detailed (adds the API-layer region and node name)
SERVING_SERVER_TIMING=generic
# Days of per-minute RTT samples kept in node_latency_samples
LATENCY_RETENTION_DAYS=14
# Placement prefers nodes close to the API layers that carry a deployment's traffic (no effect without RTT data)
SCHEDULER_LATENCY_AWARE=true
# Placement score points a node loses at SCHEDULER_LATENCY_SCALE_MS over the best candidate's traffic-weighted RTT
SCHEDULER_LATENCY_WEIGHT=30.0
# RTT difference (ms) placement treats as equal
SCHEDULER_LATENCY_TOLERANCE_MS=5.0
# RTT excess (ms) at which the full SCHEDULER_LATENCY_WEIGHT applies
SCHEDULER_LATENCY_SCALE_MS=50.0
# Score points per unit of inter-node link cost for pipeline stages on different nodes (other cluster 3, other zone 2, other rack 1, plus measured RTT)
SCHEDULER_LINK_COST_WEIGHT=10.0
# Hours of per-region request counts placement weighs RTT by
SCHEDULER_TRAFFIC_WINDOW_HOURS=24

# ---------- Web (copy to apps/web/.env.local; read by Next.js, not the backend) ----------
# NEXT_PUBLIC_APP_NAME="GPU Deck"
# NEXT_PUBLIC_API_URL=http://localhost:8180/api/v1
# NEXT_PUBLIC_SERVING_URL=http://localhost:8181
# NEXT_PUBLIC_SESSION_COOKIE=gpudeck_session
# NEXT_PUBLIC_APP_BYLINE="GPU control plane"
