# GPU Deck — repository-wide ignore rules.
# Component-specific rules live next to the code (apps/*/.gitignore).

# ---- Secrets and local configuration ---------------------------------------------------------
# Real values live only in .env files; the generated .env.example files are committed.
# (.env also covers infra/docker/.env, the generated dev-dependency credentials.)
.env
.env.local
.env*.local
.env.test
.env.*.bak
.env.bak*

# Dev PKI and any key material
certs/
*.pem
*.key
*.crt
*.p12
*.pfx

# ---- Dependencies ----------------------------------------------------------------------------
node_modules/
venv/
.venv/

# ---- Build output ----------------------------------------------------------------------------
dist/
tmp/
/out-tsc
.next/
.next-*/
next-env.d.ts
*.tsbuildinfo
target/
*.rs.bk

# ---- Caches, test and coverage output --------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
/coverage
coverage/
.cache/

# ---- Runtime state and logs ------------------------------------------------------------------
*.log
# recorded engine logs the agent's parsers are tested against
!apps/node-agent/fixtures/**/*.log
/logs/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
celerybeat-schedule*
apps/fastapi/.run/
apps/fastapi/logs/

# ---- Editors and OS files --------------------------------------------------------------------
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.husky
.DS_Store
Thumbs.db

# ---- Local-only files (never published) ------------------------------------------------------
# Internal planning docs and agent notes
/docs/internal/
/.claude/
/CLAUDE.md
/claude.md
/apps/web/AGENTS.md
/apps/web/CLAUDE.md

# Maintainer-only demo seed (simulated fleet + usage history) and its tests.
# bootstrap.dev.sh seed-demo and the test suite both handle their absence.
/apps/fastapi/app/db/postgres/demo/
/apps/fastapi/app/db/postgres/scripts/seed_demo.py
/apps/fastapi/tests/**/test_demo_seed*.py

# Local screenshot capture config (pins rows, adds setup hooks; see docs/screenshots/capture.mjs)
/docs/screenshots/capture.config.mjs

# ---- Generated by CI (.github/workflows/pages.yml) -------------------------------------------
# scripts/build_docs.py renders the docs; website/sync-screenshots.sh copies the screenshots.
/website/docs/
/website/assets/screenshots/

# Brand: scratch tile PNGs from assets/brand/build.py, and the website's Open Graph image, which
# website/sync-screenshots.sh copies from assets/brand/social-preview.png at build time
/assets/brand/.build/
/website/assets/brand/og-image.png

# CLI: the wheel/sdist build (apps/cli/hatch_build.py) copies libs/contracts/openapi/admin.yaml in;
# the contract stays the single source of truth, so the copy is never committed.
/apps/cli/gpudeck/_spec/
